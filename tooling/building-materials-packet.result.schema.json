{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.invalid/schemas/building-materials-packet-result.v0.1.json",
  "title": "AXM Building Materials packet result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result",
    "tool_id",
    "implementation_head",
    "implementation_sha256",
    "builder_sha256",
    "manifest_sha256",
    "request_sha256",
    "source_head",
    "evidence_scopes",
    "outputs",
    "open_gates",
    "receipt"
  ],
  "properties": {
    "schema": {"const": "axm.building-materials-tool-result/v0.1"},
    "result": {"const": "PASS_BUILDING_MATERIALS_PACKET"},
    "tool_id": {"const": "axm.building.materials.packet"},
    "implementation_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "builder_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evidence_scopes": {
      "const": ["structural"]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "payload_sha256", "receipt", "receipt_sha256"],
      "properties": {
        "payload": {"const": "building_material_payload.json"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt": {"const": "build_receipt.json"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "open_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "receipt": {"type": "object"}
  }
}
